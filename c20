#include<stdio.h>
void swap(int*a,int*b)
{
   int temp=*a;
   *a=*b;
   *b=temp;
}
int main()
{
   int n1,n2;
   printf("Enter the num n1:");
   scanf("%d",&n1);
   printf("Enter the num n2;");
   scanf("%d",&n2);
   printf("\nBefore swapping num1=%d num2=%d",n1,n2);
   swap(&n1,&n2);
   printf("\nAfter swapping num1=%d num2=%d",n1,n2);
   return 0;
}

