#include<stdio.h>
struct Student
{
   char name[50];
   int regno,mrk1,mrk2,mrk3,mrk4,total;
   float average;
};
int main()
{
   int n;
   printf("Enter the num of studs:");
   scanf("%d",&n);
   struct Student studs[n];
   int i;
   for(i=0;i<n;i++)
   {
      printf("Enter the details of student:%d\n",i+1);
      printf("Name:\n");
      scanf("%s",&studs[i].name);
      printf("Register Num:\n");
      scanf("%d",&studs[i].regno);
      printf("Mark1:\n");
      scanf("%d",&studs[i].mrk1);
      printf("Mark2:\n");
      scanf("%d",&studs[i].mrk2);
      printf("Mark3:\n");
      scanf("%d",&studs[i].mrk3);
      printf("Mark4:\n");
      scanf("%d",&studs[i].mrk4);
      studs[i].total=studs[i].mrk1+studs[i].mrk2+studs[i].mrk3+studs[i].mrk4;
      studs[i].average=(studs[i].total)/4.0;
   }
   printf("\nStudents with average Higher than 50%\n");
   for(i=0;i<n;i++)
   {
      if(studs[i].average>50.0)
         printf("\n Name:%s\nRegistration Num:%d\nTotal Mark:%d\nAverageMark:%2lf\n",studs[i].name,studs[i].regno,studs[i].total,studs[i].average);
   }
   return 0;
}
