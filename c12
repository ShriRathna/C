#include<stdio.h>
int main()
{
   int i,n,r,nr,s;
   long int nf=1,rf=1,nrf=1,ncr;
   printf("Enter n and c:");
   scanf("%d %d",&n,&r);
   nr=n-r;
   if(r>n)
      printf("INVALID");
   if ((n==0)||(r==0)||(nr==0))
   {
      if(n==0)
         nf=1;
      else if(r==0)
         rf=1;
      else
         nrf=0;
   }
   for(i=1;i<=n;i++)
   {
      nf=nf*i;
   }
   for(i=1;i<=r;i++)
   {
      rf=rf*i;
   }
   s=n-r;
   for(i=1;i<=s;i++)
   {
      nrf=nrf*i;
   }
   ncr=nf/(rf*nrf);
   printf("ncr=%ld",ncr);
}
