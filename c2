#include<stdio.h>
#include<math.h>
int main()
{
   double  x1,x2,y1,y2,d,d2;
   printf("Enter the coordinates for 1st loc (x1,y1):");
   scanf("%lf %lf",&x1, &y1);
   printf("Enter the coordinates for 1st loc (x2,y2):");
   scanf("%lf %lf",&x2, &y2);
   d=(((x2-x1)*(x2-x1))+((y2-y1)*(y2-y1)));
   d2=sqrt(d);
   printf("The distance between the two location is %.2lf\n",d2);
   return 0;
}
