#include<stdio.h>
void main()
{
   int i,n,arr[100];
   printf("Enter the number of cadets:");
   scanf("%d",&n);
   printf("Enter the go in order:\n");
   for(i=0;i<n;i++)
   {
      printf("Roll num of cadet %d:",i+1);
      scanf("%d",&arr[i]);
   }
   printf("Enter the go out order:\n");
   for(i=(n-1);i>=0;i--)
   {
      printf("%d\n",arr[i]);
   }
}
