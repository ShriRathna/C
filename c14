#include<stdio.h>
int a,b;
void exchange()
{
   int temp;
   printf("Enter a:");
   scanf("%d",&a);
   printf("Enter b:");
   scanf("%d",&b);
   printf("Before interchanging a=%d and b=%d \n",a,b);
   temp=a;
   a=b;
   b=temp;
   printf("After interchanging a=%d and b=%d \n",a,b);
   }
int main()
{
   exchange();
   return 0;
}
