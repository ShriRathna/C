#include<stdio.h>
int prime(int d)
{
   int i,x;
   x=0;
   for (i=2;i<d/2;i++)
   {
      if(d%i==0)
         x=1;
      else
         continue;
   }
   if (x==0)
      return 1;
   else
      return 2;
}
